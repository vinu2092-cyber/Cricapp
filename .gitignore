# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/

# Deployment
.vercel

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/
/opt/

# Expo
frontend/.expo/
frontend/.metro-cache/

# ============ CRITICAL: Block heavy/sensitive files ============

# Core dumps and system files (qemu, crash dumps)
*.core
qemu_*
*.dump

# Sensitive files - NEVER push
KEYSTORE_INFO_SAVE_THIS.md
SENSITIVE_INFO_PRIVATE.md
CRICAPP_ALL_IDS_KEYS.md
KEYSTORE_GENERATION_GUIDE.md
*token.json*
*credentials.json*
*.pem
*.key
*.keystore
!frontend/android/app/debug.keystore

# Android build outputs
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
*.apk
*.aab

# Temporary build files
*.bin
*.o
*.obj
*.so
*.a

# Environment and credential files
.env
.env.*
*.env

# Android project clones
android-project/
